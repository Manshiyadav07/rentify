# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Production or Localhost Development)
# Production Atlas: mongodb+srv://<username>:<password>@<cluster-url>/rentify?retryWrites=true&w=majority
# Localhost Dev:   mongodb://localhost:27017/rentify
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/rentify?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Daily Late Fee (INR)
DAILY_LATE_FEE=10

# Razorpay Payment Gateway (Optional - Built-in sandbox mode active if empty)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Assistant Configuration (Optional - Real-time database NLP engine active if empty)
GROK_API_KEY=your_xai_or_openai_api_key_here
GROK_MODEL=grok-beta
GROK_API_URL=https://api.x.ai/v1/chat/completions

# Default Seeder Passwords (Optional)
ADMIN_PASSWORD=your_admin_password
DEFAULT_PASSWORD=your_user_password
